# Dharohar Setu Environment Template
# Copy this file to .env and configure your variables

PORT=5173
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require"
REMOTE_BACKEND_URL=https://your-remote-heritage-backend.onrender.com

# SMTP Email Dispatch Configuration (Optional - for real email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Dharohar Setu <noreply@dharohar.app>"
