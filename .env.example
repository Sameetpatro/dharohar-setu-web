# Dharohar Setu / Humsafar Environment Template
# Copy this file to .env and configure your variables

# -----------------------------------------------------------------------------
# CLIENT-SIDE CONFIGURATION (Vite Public Variables - Safe for browser)
# -----------------------------------------------------------------------------
# Official Android APK or Google Play Store download URL
VITE_ANDROID_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=com.example.humsafar

# Public Web Domain URL
VITE_PUBLIC_APP_URL=https://dharohar-setu.vercel.app

# Android Application Package ID
VITE_ANDROID_PACKAGE_NAME=com.example.humsafar

# -----------------------------------------------------------------------------
# SERVER-SIDE CONFIGURATION (Only for Admin Portal Backend - Keep Private)
# -----------------------------------------------------------------------------
PORT=5173
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require"
REMOTE_BACKEND_URL=https://humsafar-backend-5u74.onrender.com
